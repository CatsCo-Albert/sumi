# CatsCo auth — required for JWT verify + ApiKey introspect
OC_JWT_SECRET=your-jwt-secret-shared-with-catsco
CATSCO_BASE_URL=http://localhost:8080
CATSCO_SERVICE_TOKEN=catsco_service_token_for_introspect

# WS server
WS_PORT=12345
# Browser-facing WS URL — when unset the editor derives ws(s)://<host>:<NEXT_PUBLIC_WS_PORT>
NEXT_PUBLIC_WS_URL=ws://localhost:12345
NEXT_PUBLIC_WS_PORT=12345
NEXT_PUBLIC_SUMI_HTTP_URL=http://localhost:3000

# Deployment knobs
# WS_CORS_ORIGIN=              # single exact origin; empty = no CORS (default)
# NEXT_PUBLIC_BASE_PATH=       # set when serving under /<app-id>/ behind the gateway
# CATSCO_ARTIFACT_APP_ID=      # enables artifact-gateway viewer-cookie auth
# CATSCO_GATEWAY_URL=          # defaults to https://artifact.catsco.cc

# Sumi DB (defaults to ./data)
SUMI_DATA_DIR=./data

# Optional — Yjs persistence across restarts
# REDIS_URL=redis://localhost:6379

# Internal admin routes (must be set for /api/internal/* mutations)
INTERNAL_API_SECRET=your-internal-secret

# TAP ghost-text completion (optional — unset OPENAI_API_KEY = feature off)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# TAP_MODEL=gpt-4o-mini
# NEXT_PUBLIC_TAP_ENABLED=true   # 暴露 TAP 工具栏开关给用户
