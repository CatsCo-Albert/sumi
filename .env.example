# CatsCo auth — required for JWT verify + ApiKey introspect
OC_JWT_SECRET=your-jwt-secret-shared-with-catsco
CATSCO_BASE_URL=http://localhost:8080
CATSCO_SERVICE_TOKEN=catsco_service_token_for_introspect

# WS server
WS_PORT=12345
NEXT_PUBLIC_SUMI_WS_URL=ws://localhost:12345
NEXT_PUBLIC_SUMI_HTTP_URL=http://localhost:3000

# Sumi DB (defaults to ./data)
SUMI_DATA_DIR=./data

# Optional — Yjs persistence across restarts
# REDIS_URL=redis://localhost:6379

# Internal admin routes (must be set for /api/internal/* mutations)
INTERNAL_API_SECRET=your-internal-secret
