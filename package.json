{
  "name": "sumi",
  "version": "0.1.0",
  "description": "Sumi — collaborative markdown/html editor substrate. Yjs sync + CatsCo SSO + agent-driven UI patches.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "ws-server": "tsx src/server/ws-server.ts",
    "ws-dev": "tsx watch src/server/ws-server.ts",
    "co-edit-daemon": "tsx src/server/co-edit-daemon.ts",
    "server": "tsx server/src/main.ts",
    "web:build": "pnpm --dir web build",
    "typecheck": "tsc --noEmit && pnpm --dir web typecheck && pnpm --dir server typecheck",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e-solid.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "ioredis": "^5.8.2",
    "jose": "^6.2.12",
    "lib0": "^0.2.116",
    "ws": "^8.18.3",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.28",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
